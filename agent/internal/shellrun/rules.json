{
  "version": 1,
  "_comment": "Shared by agent/internal/shellrun (Go, authoritative) and backend/src/shell-run (TypeScript, mirror). Keep byte-identical: backend/tests/shell-run.test.ts fails when they differ. Docs: docs/v0.3-linux-shell-addendum.md. Anything not matched by a read rule is write; anything matched by deny is rejected.",
  "execDirs": ["/usr/sbin", "/usr/bin", "/sbin", "/bin"],
  "limits": { "maxArgs": 64, "maxArgLen": 4096 },
  "contentRoots": ["/proc", "/sys", "/var/log", "/etc", "/opt"],
  "deny": {
    "binaries": [
      "sh", "bash", "dash", "zsh", "fish", "ksh", "csh", "tcsh", "ash", "busybox",
      "python", "python2", "python3", "perl", "ruby", "node", "nodejs", "php", "lua", "awk", "gawk", "mawk", "nawk",
      "env", "sudo", "su", "doas", "timeout", "nice", "ionice", "nohup", "setsid", "watch", "xargs", "stdbuf",
      "chroot", "nsenter", "unshare", "script", "expect", "strace", "ltrace", "gdb", "at", "batch", "sshpass",
      "passwd", "chpasswd", "usermod", "useradd", "userdel", "groupadd", "groupdel", "groupmod", "visudo", "vipw", "vigr", "ssh-keygen",
      "iptables", "ip6tables", "nft", "ufw", "pve-firewall",
      "wipefs", "fdisk", "sfdisk", "cfdisk", "parted", "sgdisk", "gdisk", "shred",
      "kill", "pkill", "killall"
    ],
    "binaryPrefixes": ["mkfs"],
    "argSubstrings": [
      "/etc/shadow", "/etc/gshadow", "/etc/pve/priv", "ssh_host_", "/.ssh", "authorized_keys",
      "id_rsa", "id_ed25519", "id_ecdsa", "/etc/itsupport-agent", "/opt/itsupport-agent", "mesh_services",
      "/etc/sudoers", "service.env", "_history", "/.aws", "/.kube", "/.docker/config", "/.gnupg"
    ],
    "argSuffixes": [".pem", ".key", ".p12", ".pfx"],
    "pathRegex": ["^/proc/[^/]+/(environ|mem)$", "^/proc/kcore$"],
    "argPrefixes": ["of=/dev/"],
    "systemctl": {
      "bins": ["systemctl", "service"],
      "mutatingVerbs": ["stop", "disable", "mask", "restart", "reload", "kill", "edit", "set-property", "revert", "try-restart", "reload-or-restart", "unmask", "start"],
      "protected": ["itsupport", "meshagent"]
    },
    "recursiveCritical": {
      "bins": ["rm", "chmod", "chown", "chgrp"],
      "recursiveFlags": ["--recursive"],
      "recursiveShort": "rR",
      "extraDenyFlags": ["--no-preserve-root"],
      "critical": ["/", "/*", "/boot", "/etc", "/var", "/usr", "/home", "/root", "/bin", "/sbin", "/lib", "/lib64", "/opt", "/srv", "/dev", "/proc", "/sys"]
    },
    "forceFlags": { "bins": ["reboot", "poweroff", "halt", "shutdown"], "flags": ["-f", "--force", "-ff"] }
  },
  "read": [
    { "id": "pveversion", "bin": "pveversion", "flags": ["-v"] },
    { "id": "qm.list", "bin": "qm", "sub": ["list"], "flags": ["--full"] },
    { "id": "qm.status", "bin": "qm", "sub": ["status"], "flags": ["--verbose"], "maxPos": 1, "pos": "^[0-9]{1,9}$" },
    { "id": "qm.config", "bin": "qm", "sub": ["config"], "flags": ["--current"], "maxPos": 1, "pos": "^[0-9]{1,9}$" },
    { "id": "qm.listsnapshot", "bin": "qm", "sub": ["listsnapshot"], "maxPos": 1, "pos": "^[0-9]{1,9}$" },
    { "id": "pct.list", "bin": "pct", "sub": ["list"] },
    { "id": "pct.status", "bin": "pct", "sub": ["status"], "maxPos": 1, "pos": "^[0-9]{1,9}$" },
    { "id": "pct.config", "bin": "pct", "sub": ["config"], "flags": ["--current"], "maxPos": 1, "pos": "^[0-9]{1,9}$" },
    { "id": "pct.listsnapshot", "bin": "pct", "sub": ["listsnapshot"], "maxPos": 1, "pos": "^[0-9]{1,9}$" },
    { "id": "pvesm.status", "bin": "pvesm", "sub": ["status"], "flags": ["--enabled"] },
    { "id": "pvesm.list", "bin": "pvesm", "sub": ["list"], "maxPos": 1, "pos": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    { "id": "pvesh.get", "bin": "pvesh", "sub": ["get"], "valueFlags": { "--output-format": "^(json|text|yaml|json-pretty)$" }, "maxPos": 1, "pos": "^/(nodes|cluster/resources|cluster/status|storage|version)(/[A-Za-z0-9_:-][A-Za-z0-9_.:-]*)*$" },
    { "id": "pvecm.status", "bin": "pvecm", "sub": ["status"] },
    { "id": "pvecm.nodes", "bin": "pvecm", "sub": ["nodes"] },
    { "id": "zpool.list", "bin": "zpool", "sub": ["list"], "short": "Hpv", "maxPos": 8, "pos": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$" },
    { "id": "zpool.status", "bin": "zpool", "sub": ["status"], "short": "vxPpt", "maxPos": 8, "pos": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$" },
    { "id": "zfs.list", "bin": "zfs", "sub": ["list"], "short": "Hpr", "valueFlags": { "-t": "^[a-z,]{1,40}$", "-o": "^[A-Za-z0-9_,:.-]{1,200}$", "-s": "^[A-Za-z0-9_.:-]{1,64}$" }, "maxPos": 8, "pos": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,255}$" },
    { "id": "zfs.get", "bin": "zfs", "sub": ["get"], "short": "Hpr", "valueFlags": { "-o": "^[A-Za-z0-9_,:.-]{1,200}$" }, "maxPos": 8, "pos": "^[A-Za-z0-9][A-Za-z0-9._:/@,-]{0,255}$" },
    { "id": "lsblk", "bin": "lsblk", "short": "afpbdnlJmPi", "valueFlags": { "-o": "^[A-Za-z0-9_,:-]{1,200}$", "--output": "^[A-Za-z0-9_,:-]{1,200}$" }, "maxPos": 8, "pos": "^/dev/[A-Za-z0-9/_.-]{1,64}$" },
    { "id": "df", "bin": "df", "short": "hTiPaHk", "flags": ["--total", "--output"], "maxPos": 16, "paths": "meta" },
    { "id": "du", "bin": "du", "short": "shxckmg", "valueFlags": { "-d": "^[0-9]{1,2}$", "--max-depth": "^[0-9]{1,2}$" }, "maxPos": 8, "paths": "meta" },
    { "id": "findmnt", "bin": "findmnt", "short": "lnrDtAPRU", "flags": ["--json"], "maxPos": 2, "pos": "^/[A-Za-z0-9/_.-]{0,200}$" },
    { "id": "free", "bin": "free", "short": "hmgbkwt" },
    { "id": "uptime", "bin": "uptime", "short": "ps" },
    { "id": "uname", "bin": "uname", "short": "asnrvmpio" },
    { "id": "lscpu", "bin": "lscpu", "short": "ep", "flags": ["--json"] },
    { "id": "lsmem", "bin": "lsmem", "short": "abnr" },
    { "id": "hostnamectl", "bin": "hostnamectl", "sub": ["status"] },
    { "id": "hostnamectl.bare", "bin": "hostnamectl" },
    { "id": "timedatectl", "bin": "timedatectl", "sub": ["status"] },
    { "id": "timedatectl.bare", "bin": "timedatectl" },
    { "id": "hostname", "bin": "hostname" },
    { "id": "whoami", "bin": "whoami" },
    { "id": "id", "bin": "id", "short": "ugnGr" },
    { "id": "nproc", "bin": "nproc", "flags": ["--all"] },
    { "id": "date", "bin": "date", "flags": ["-u", "--utc", "--iso-8601"], "maxPos": 1, "pos": "^\\+[A-Za-z0-9%:_ /.-]{1,40}$" },
    { "id": "ip", "bin": "ip", "short": "46sjd", "flags": ["-br", "-brief", "-o", "-c"], "maxPos": 3, "pos": "^(addr|address|a|route|r|link|l|neigh|n|show|ls|list)$" },
    { "id": "ss", "bin": "ss", "short": "tulpnaHs46eoimrx", "maxPos": 0 },
    { "id": "lsmod", "bin": "lsmod" },
    { "id": "lspci", "bin": "lspci", "short": "vnkmt" },
    { "id": "lsusb", "bin": "lsusb", "short": "tv" },
    { "id": "who", "bin": "who", "short": "abdHlpqrtTu" },
    { "id": "last", "bin": "last", "short": "aFRwxi", "valueFlags": { "-n": "^[0-9]{1,4}$" } },
    { "id": "dmesg", "bin": "dmesg", "short": "TLHkuxe", "flags": ["--notime", "--ctime", "--human"], "valueFlags": { "-l": "^[a-z,]{1,40}$", "--level": "^[a-z,]{1,40}$" } },
    { "id": "ps", "bin": "ps", "short": "aefuxHlwT", "maxPos": 3, "pos": "^(aux|auxww|axu|ef|-ef|ax|a)$", "valueFlags": { "-o": "^[A-Za-z0-9_,%=:+-]{1,200}$", "-p": "^[0-9,]{1,60}$" } },
    { "id": "smartctl", "bin": "smartctl", "short": "HiAaxc", "flags": ["--json", "--scan"], "maxPos": 1, "pos": "^/dev/[A-Za-z0-9/_.-]{1,64}$" },
    { "id": "sensors", "bin": "sensors", "short": "Auf", "flags": ["--no-adapter"] },
    { "id": "ls", "bin": "ls", "short": "lahRtS1dFnirp", "flags": ["--color=never", "--full-time", "--time-style=long-iso"], "maxPos": 16, "paths": "meta" },
    { "id": "stat", "bin": "stat", "short": "LfF", "flags": ["--terse"], "maxPos": 16, "paths": "meta" },
    { "id": "cat", "bin": "cat", "short": "n", "maxPos": 8, "paths": "content" },
    { "id": "head", "bin": "head", "valueFlags": { "-n": "^[0-9]{1,5}$", "-c": "^[0-9]{1,7}$" }, "maxPos": 8, "paths": "content" },
    { "id": "tail", "bin": "tail", "valueFlags": { "-n": "^[0-9]{1,5}$", "-c": "^[0-9]{1,7}$" }, "maxPos": 8, "paths": "content" },
    { "id": "systemctl.status", "bin": "systemctl", "sub": ["status"], "short": "l", "flags": ["--no-pager", "--all", "--full"], "maxPos": 8, "pos": "^[A-Za-z0-9@:._-]{1,128}$" },
    { "id": "systemctl.is-active", "bin": "systemctl", "sub": ["is-active"], "flags": ["--no-pager"], "maxPos": 8, "pos": "^[A-Za-z0-9@:._-]{1,128}$" },
    { "id": "systemctl.is-enabled", "bin": "systemctl", "sub": ["is-enabled"], "flags": ["--no-pager"], "maxPos": 8, "pos": "^[A-Za-z0-9@:._-]{1,128}$" },
    { "id": "systemctl.show", "bin": "systemctl", "sub": ["show"], "flags": ["--no-pager", "--all"], "valueFlags": { "-p": "^[A-Za-z0-9,]{1,200}$", "--property": "^[A-Za-z0-9,]{1,200}$" }, "maxPos": 8, "pos": "^[A-Za-z0-9@:._-]{1,128}$" },
    { "id": "systemctl.list-units", "bin": "systemctl", "sub": ["list-units"], "short": "a", "flags": ["--no-pager", "--all", "--failed", "--no-legend"], "valueFlags": { "--type": "^[a-z,]{1,40}$", "-t": "^[a-z,]{1,40}$", "--state": "^[a-z,-]{1,60}$" }, "maxPos": 4, "pos": "^[A-Za-z0-9@:.*_-]{1,128}$" },
    { "id": "systemctl.list-timers", "bin": "systemctl", "sub": ["list-timers"], "flags": ["--no-pager", "--all"] },
    { "id": "systemctl.list-unit-files", "bin": "systemctl", "sub": ["list-unit-files"], "flags": ["--no-pager"], "valueFlags": { "--type": "^[a-z,]{1,40}$", "--state": "^[a-z,-]{1,60}$" } },
    { "id": "journalctl", "bin": "journalctl", "short": "rkb", "flags": ["--no-pager", "--utc"], "valueFlags": { "-n": "^[0-9]{1,5}$", "--lines": "^[0-9]{1,5}$", "-u": "^[A-Za-z0-9@:._-]{1,128}$", "--unit": "^[A-Za-z0-9@:._-]{1,128}$", "-p": "^[a-z0-9..]{1,20}$", "--priority": "^[a-z0-9..]{1,20}$", "--since": "^[0-9A-Za-z:+ -]{1,40}$", "--until": "^[0-9A-Za-z:+ -]{1,40}$", "-o": "^(short|short-iso|json|cat)$", "--output": "^(short|short-iso|json|cat)$" } },
    { "id": "docker.ps", "bin": "docker", "sub": ["ps"], "short": "aqs", "flags": ["--no-trunc"], "valueFlags": { "--format": "^[A-Za-z0-9{}. :|/_-]{1,200}$", "--filter": "^[A-Za-z0-9=_.:/-]{1,128}$", "-f": "^[A-Za-z0-9=_.:/-]{1,128}$" } },
    { "id": "docker.images", "bin": "docker", "sub": ["images"], "short": "aq", "flags": ["--no-trunc"], "valueFlags": { "--format": "^[A-Za-z0-9{}. :|/_-]{1,200}$" } },
    { "id": "docker.inspect", "bin": "docker", "sub": ["inspect"], "valueFlags": { "--format": "^[A-Za-z0-9{}. :|/_-]{1,200}$", "-f": "^[A-Za-z0-9{}. :|/_-]{1,200}$" }, "maxPos": 8, "pos": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
    { "id": "docker.logs", "bin": "docker", "sub": ["logs"], "short": "t", "flags": ["--timestamps"], "valueFlags": { "--tail": "^[0-9]{1,5}$", "--since": "^[0-9A-Za-z:+ -]{1,40}$", "--until": "^[0-9A-Za-z:+ -]{1,40}$" }, "maxPos": 1, "pos": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
    { "id": "docker.stats", "bin": "docker", "sub": ["stats"], "short": "a", "flags": ["--no-stream", "--no-trunc"], "valueFlags": { "--format": "^[A-Za-z0-9{}. :|/_%-]{1,200}$" }, "maxPos": 8, "pos": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
    { "id": "docker.info", "bin": "docker", "sub": ["info"] },
    { "id": "docker.version", "bin": "docker", "sub": ["version"] },
    { "id": "docker.network.ls", "bin": "docker", "sub": ["network", "ls"] },
    { "id": "docker.volume.ls", "bin": "docker", "sub": ["volume", "ls"] },
    { "id": "docker.compose.ls", "bin": "docker", "sub": ["compose", "ls"], "short": "a" }
  ]
}
