# Copy to infra/.env (gitignored). Required production values are listed first.

WEB_PORT=18080
AGENT_MTLS_PORT=18443
APP_PUBLIC_URL=https://support.example.com
AGENT_PUBLIC_URL=https://agent.support.example.com
CORS_ORIGINS=https://support.example.com
FIREBASE_PROJECT_ID=it-support-51d38
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- AI orchestration ---
OPENAI_API_KEY=
# Point at any OpenAI-compatible endpoint (optional).
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# Computer-use addendum (docs/v0.1-computer-use-addendum.md) — needs a model
# that supports the Responses API "computer" tool (computer-use-preview is
# retired — confirmed via a real 404 from the live API).
OPENAI_COMPUTER_USE_MODEL=gpt-5.6-sol
# Customer-facing status/chat view (desktop.open_customer_view) — the agent
# opens the customer's browser here + /tickets/:id/customer.
FRONTEND_URL=https://support.example.com

# --- Human takeover fallback ---
MESHCENTRAL_URL=

# --- v0.2 marketing-ops OAuth token custody ---
# Generate each: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OAUTH_TOKEN_ENC_KEY=
OAUTH_STATE_SECRET=
OAUTH_REDIRECT_BASE_URL=https://support.example.com/api

# --- Device backup (restic), see docs/backup.md ---
# Raw restic.exe hosted next to the agent downloads, plus its SHA-256.
RESTIC_WINDOWS_URL=https://support.example.com/downloads/agent/restic-windows-amd64.exe
RESTIC_WINDOWS_SHA256=

# Optional external remote support console; see meshcentral-ca.md
MESHCENTRAL_URL=

# Scoped MeshCentral service account; backend only, never expose in frontend.
MESHCENTRAL_API_USER=
MESHCENTRAL_API_PASSWORD=

# --- Support chatbot (SchoolsAI workspace "itsupport-system") ---
# One workspace serves both tiers: system advice (knowledge base) and
# per-account advice with tenant-scoped tools run by this backend.
# Without the key the chat widget hides itself. Sync docs/prompt with
# `npm run support-chat:sync` in backend/.
SCHOOLSAI_API_URL=https://apic.schoolsai.work
SCHOOLSAI_API_KEY=
