# Copy to infra/.env (gitignored) and fill what you need. docker-compose.yml
# reads this file automatically. Everything here is OPTIONAL — the stack runs
# without it; the AI-step and OAuth endpoints just fail with a clear error
# instead of faking a result.

# --- AI orchestration ---
OPENAI_API_KEY=
# Point at any OpenAI-compatible endpoint (optional).
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# --- Human takeover fallback ---
MESHCENTRAL_URL=

# --- v0.2 marketing-ops OAuth token custody ---
# Generate each: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OAUTH_TOKEN_ENC_KEY=
OAUTH_STATE_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:3000
