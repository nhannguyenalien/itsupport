DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# AI orchestration (backend/src/ai-orchestration) — without this set, POST
# /tickets/:id/ai-step fails with a clear error instead of faking a response.
OPENAI_API_KEY=
# Optional: point at any OpenAI-compatible endpoint instead of api.openai.com
OPENAI_BASE_URL=
# Optional, defaults to gpt-4o-mini
OPENAI_MODEL=

# Human takeover fallback (see tickets/routes.ts GET /tickets/:id/takeover-link).
# Real instance is up (see infra/meshcentral-ca.md) but not yet reachable through
# the user's Cloudflare Tunnel, and no device has a meshcentral_device_id yet
# (that needs the installer to bundle MeshCentral's mesh agent — unbuilt).
MESHCENTRAL_URL=https://support-agent-mesh.toidayhoc.com
