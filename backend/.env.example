DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
CORS_ORIGINS=http://localhost:3001
FIREBASE_PROJECT_ID=it-support-51d38

# AI orchestration (backend/src/ai-orchestration) — without this set, POST
# /tickets/:id/ai-step fails with a clear error instead of faking a response.
OPENAI_API_KEY=
# Optional: point at any OpenAI-compatible endpoint instead of api.openai.com
OPENAI_BASE_URL=
# Optional, defaults to gpt-4o-mini
OPENAI_MODEL=

# Computer-use addendum (backend/src/computer-use, docs/v0.1-computer-use-addendum.md)
# — uses the same OPENAI_API_KEY above but needs a model that actually supports
# the Responses API "computer" tool (computer-use-preview is retired — confirmed
# via a real 404 from the live API). Optional, defaults to gpt-5.6-sol.
OPENAI_COMPUTER_USE_MODEL=

# Customer-facing status/chat view (desktop.open_customer_view,
# docs/v0.1-computer-use-addendum.md) — the agent opens the customer's
# browser here + /tickets/:id/customer when a computer-use session starts.
# No trailing slash. Optional, defaults to http://localhost:3001.
FRONTEND_URL=http://localhost:3001

# Human takeover fallback (see tickets/routes.ts GET /tickets/:id/takeover-link).
# Real instance is up (see infra/meshcentral-ca.md) but not yet reachable through
# the user's Cloudflare Tunnel, and no device has a meshcentral_device_id yet
# (that needs the installer to bundle MeshCentral's mesh agent — unbuilt).
MESHCENTRAL_URL=https://support-agent-mesh.toidayhoc.com

# v0.2 marketing-ops OAuth (backend/src/oauth) — token custody for ads/analytics
# platforms. Without these two, POST /oauth/*/connect|callback fails honestly
# instead of faking a connection. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OAUTH_TOKEN_ENC_KEY=
OAUTH_STATE_SECRET=
# Where the platform redirects back to after consent — must exactly match what's
# registered in each platform's OAuth app config (Google Cloud Console / Meta
# for Developers). No trailing slash.
OAUTH_REDIRECT_BASE_URL=http://localhost:3000

# Per-platform OAuth app credentials — none of these exist yet. Each requires
# registering a real app with that platform first (Google Cloud Console for
# google_ads/ga4, Meta for Developers + app review for meta_ads's
# ads_management scope — see docs/v0.2-marketing-ops-spec.md known gaps).
GOOGLE_ADS_OAUTH_CLIENT_ID=
GOOGLE_ADS_OAUTH_CLIENT_SECRET=
GA4_OAUTH_CLIENT_ID=
GA4_OAUTH_CLIENT_SECRET=
META_ADS_OAUTH_CLIENT_ID=
META_ADS_OAUTH_CLIENT_SECRET=

# Scoped MeshCentral service account; backend only, never expose in frontend.
MESHCENTRAL_API_USER=
MESHCENTRAL_API_PASSWORD=

# --- Support chatbot (SchoolsAI workspace "itsupport-system") ---
# One workspace serves both tiers: system advice (knowledge base) and
# per-account advice with tenant-scoped tools run by this backend.
# Without the key the chat widget hides itself. Sync docs/prompt with
# `npm run support-chat:sync` in backend/.
SCHOOLSAI_API_URL=https://apic.schoolsai.work
SCHOOLSAI_API_KEY=
