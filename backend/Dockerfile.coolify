# Backend for the Coolify deployment: the standard backend plus the tools the
# platform database backup (src/db-backup) shells out to. macmini keeps using the
# plain Dockerfile; there the feature reports the tools as missing.
#
# Pinned to Alpine 3.23: it ships postgresql18-client (pg_dump can read servers
# up to 18, so it works with older Neon versions) and restic from the same index.
FROM node:22-alpine3.23 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build
RUN mkdir -p dist/tool-registry && cp src/tool-registry/registry.json dist/tool-registry/registry.json

FROM node:22-alpine3.23
WORKDIR /app
ENV NODE_ENV=production
RUN apk add --no-cache openssl postgresql18-client restic \
 && pg_dump --version && pg_restore --version && restic version
COPY package.json package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
RUN npm prune --omit=dev --ignore-scripts --offline --no-audit --no-fund
COPY --from=build /app/dist ./dist
# restic cache lives on a named volume (the root filesystem is read-only); the
# directory is owned by `node` here so a fresh volume inherits that.
RUN mkdir -p /cache && chown node:node /cache
USER node
EXPOSE 3000
CMD ["node", "dist/index.js"]
